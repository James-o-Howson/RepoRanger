{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "OutboxProcessingOptions": {
        "BatchSize": 100
    },
    "BackgroundJobOptions": {
        "Jobs": [
            {
                "Enabled": true,
                "JobName": "VcsParserJob",
                "NextJobName": "VulnerabilityDiscoveryJob"
            },
            {
                "Enabled": true,
                "JobName": "VulnerabilityDiscoveryJob"
            },
            {
                "Enabled": true,
                "JobName": "OutboxMessageProcessorJob"
            }
        ]
    },
    "ConnectionStrings": {
        "RepoRangerDatabase": "Data Source=RepoRanger.db"
    },
    "VersionControlSystemParserOptions": {
        "Values": [
            {
                "Name": "Local",
                "Location": "C:\\Development\\git",
                "Enabled": true
            }
        ]
    },
    "OsvClientOptions": {
        "BaseUrl": "https://api.osv.dev/"
    }
}
